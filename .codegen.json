{
  "mode": "go_v0",
  "version": {
    "version/version.go": "const Version = \"$VERSION\""
  },
  "sync": {
    "allow_from_packages": [
      "**/*.{go,md,tmpl}",
      "**/go.{mod,sum}",
      "**/testdata/**",
      ".package.json",
      ".claude/settings.local.json",
      ".codegen.json",
      ".codegen/{_last_sha,_openapi_sha,changelog.json}",
      ".cursor/rules/*.mdc",
      ".cursorrules",
      ".gitattributes",
      ".gitignore",
      ".goreleaser.yml",
      ".mockery.yaml",
      ".github/**/*.yml",
      ".github/conftest/rules/*.rego",
      ".vscode/{extensions.json,settings.json,testing.code-snippets}",
      "DCO",
      "LICENSE",
      "NOTICE",
      "Makefile",
      "SECURITY.md",
      "staticcheck.conf",
      "test-config.yaml"
    ],
    "skip_from_genkit": [
      "tagging.py",
      "tagging.py.lock",
      ".github/workflows/tagging.yml",
      ".github/workflows/next-changelog.yml"
    ],
    "skip_from_source": [
      "BUILD",
      "BUILD.bazel",
      "OWNERS",
      "vendor",
      ".nextchanges",
      "NEXT_CHANGELOG.md",
      "tagging.yml",
      "next-changelog.yml"
    ]
  },
  "toolchain": {
    "required": [
      "go"
    ],
    "post_generate": [
      "make fmt",
      "go run github.com/vektra/mockery/v3@3d6befc6338dad94751c7b2657d42d74b2ff5693"
    ]
  }
}
